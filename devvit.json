{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "modmemoryx",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "index.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "entry": "server/index.js"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "moderator"
    },
    "http": {
      "domains": [
        "api.openai.com"
      ]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Capture decision memory",
        "description": "Save a precedent with rule tag, outcome, and explanation template.",
        "forUserType": "moderator",
        "location": [
          "post",
          "comment"
        ],
        "endpoint": "/internal/menu/capture-decision"
      },
      {
        "label": "Show decision precedents",
        "description": "Open the decision memory app for similar prior cases.",
        "forUserType": "moderator",
        "location": [
          "post",
          "comment",
          "subreddit"
        ],
        "endpoint": "/internal/menu/show-precedents"
      }
    ]
  },
  "forms": {
    "decisionCapture": "/internal/form/capture-decision-submit"
  },
  "triggers": {
    "onModAction": "/internal/triggers/mod-action"
  },
  "scheduler": {
    "tasks": {
      "retention-cleanup": {
        "endpoint": "/internal/scheduler/retention-cleanup",
        "cron": "0 3 * * *"
      }
    }
  },
  "scripts": {
    "build": "npm run devvit:build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "modmemoryx_dev"
  },
  "settings": {
    "global": {
      "openaiApiKey": {
        "type": "string",
        "label": "OpenAI API key (enables semantic precedent matching)",
        "helpText": "Used server-side to embed decisions for similarity search. Leave blank to use keyword-only matching.",
        "isSecret": true
      }
    }
  }
}
